{
	"name": "@wrksz/themes",
	"version": "0.0.0",
	"description": "A modern, fully-featured theme management library for Next.js",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jakubwarkusz/themes.git"
	},
	"files": [
		"dist",
		"AGENTS.md"
	],
	"type": "module",
	"sideEffects": false,
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./client": {
			"import": {
				"types": "./dist/client.d.ts",
				"default": "./dist/client.js"
			}
		},
		"./client/use-theme": {
			"import": {
				"types": "./dist/client/use-theme.d.ts",
				"default": "./dist/client/use-theme.js"
			}
		},
		"./client/use-theme-value": {
			"import": {
				"types": "./dist/client/use-theme-value.d.ts",
				"default": "./dist/client/use-theme-value.js"
			}
		},
		"./client/use-theme-effect": {
			"import": {
				"types": "./dist/client/use-theme-effect.d.ts",
				"default": "./dist/client/use-theme-effect.js"
			}
		},
		"./client/use-hydrated": {
			"import": {
				"types": "./dist/client/use-hydrated.d.ts",
				"default": "./dist/client/use-hydrated.js"
			}
		},
		"./client/themed-image": {
			"import": {
				"types": "./dist/client/themed-image.d.ts",
				"default": "./dist/client/themed-image.js"
			}
		},
		"./client/provider": {
			"import": {
				"types": "./dist/client/provider.d.ts",
				"default": "./dist/client/provider.js"
			}
		},
		"./client/extended-provider": {
			"import": {
				"types": "./dist/client/extended-provider.d.ts",
				"default": "./dist/client/extended-provider.js"
			}
		},
		"./client/create-themes": {
			"import": {
				"types": "./dist/client/create-themes.d.ts",
				"default": "./dist/client/create-themes.js"
			}
		},
		"./next": {
			"import": {
				"types": "./dist/next.d.ts",
				"default": "./dist/next.js"
			}
		},
		"./next/extended": {
			"import": {
				"types": "./dist/next/extended.d.ts",
				"default": "./dist/next/extended.js"
			}
		},
		"./next/create-themes": {
			"import": {
				"types": "./dist/next/create-themes.d.ts",
				"default": "./dist/next/create-themes.js"
			}
		},
		"./script": {
			"import": {
				"types": "./dist/script.d.ts",
				"default": "./dist/script.js"
			}
		},
		"./server": {
			"import": {
				"types": "./dist/server.d.ts",
				"default": "./dist/server.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"generate:script-source": "tsx scripts/generate-script-source.ts",
		"build": "pnpm generate:script-source && tsdown",
		"dev": "pnpm generate:script-source && tsdown --watch",
		"type-check": "tsc --noEmit",
		"type-check:compat:5.9": "pnpm build && pnpm --package typescript@5.9.3 dlx tsc --noEmit && pnpm --package typescript@5.9.3 dlx tsc -p tsconfig.compat.json && tsx --tsconfig tsconfig.compat.json scripts/smoke-exports.ts",
		"type-check:compat:6": "pnpm build && pnpm --package typescript@6.0.2 dlx tsc --noEmit --stableTypeOrdering && pnpm --package typescript@6.0.2 dlx tsc -p tsconfig.compat.json --stableTypeOrdering && tsx --tsconfig tsconfig.compat.json scripts/smoke-exports.ts",
		"type-check:compat:7": "pnpm build && pnpm --package typescript@7.0.2 dlx tsc --noEmit && pnpm --package typescript@7.0.2 dlx tsc -p tsconfig.compat.json && tsx --tsconfig tsconfig.compat.json scripts/smoke-exports.ts",
		"type-check:compat": "pnpm type-check:compat:5.9 && pnpm type-check:compat:6 && pnpm type-check:compat:7",
		"lint": "oxlint --config ../../oxlint.config.ts --deny-warnings src scripts",
		"lint:fix": "oxlint --config ../../oxlint.config.ts --deny-warnings --fix src scripts",
		"format": "oxfmt --config ../../oxfmt.config.ts src scripts",
		"test": "pnpm generate:script-source --check && vitest run",
		"size": "pnpm build && tsx scripts/bundle-size.ts",
		"size:package": "tsx scripts/package-size.ts",
		"size:json": "pnpm build >/dev/null && tsx scripts/bundle-size.ts --json",
		"size:compare": "pnpm build >/dev/null && tsx scripts/bundle-size.ts --compare benchmarks/baseline.json",
		"size:update-baseline": "pnpm build >/dev/null && tsx scripts/bundle-size.ts --update-baseline",
		"test:watch": "vitest",
		"smoke:exports": "tsx --tsconfig tsconfig.compat.json scripts/smoke-exports.ts"
	},
	"devDependencies": {
		"next": ">=16.3.5",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"peerDependencies": {
		"next": ">=16.0.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"typescript": ">=5.9"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		}
	}
}
