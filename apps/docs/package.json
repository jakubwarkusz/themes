{
	"name": "theme-docs",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "pnpm --filter @wrksz/themes build && next build",
		"dev": "next dev",
		"start": "next start",
		"test": "bun test src/__tests__",
		"types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
		"postinstall": "fumadocs-mdx",
		"lint": "oxlint --config ../../oxlint.config.ts --deny-warnings src",
		"format": "oxfmt --config ../../oxfmt.config.ts src"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "^4.3.0",
		"@hugeicons/react": "^1.1.10",
		"@vercel/analytics": "^2.0.1",
		"@wrksz/themes": "workspace:*",
		"fumadocs-core": "16.15.4",
		"fumadocs-mdx": "15.4.0",
		"fumadocs-ui": "16.15.4",
		"motion": "^13.1.1",
		"next": "16.3.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"takumi-js": "^2.13.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
}
