{
	"name": "theme-docs",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "pnpm --filter @wrksz/themes build && next build",
		"dev": "next dev",
		"start": "next start",
		"test": "vitest run",
		"types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
		"postinstall": "fumadocs-mdx",
		"lint": "oxlint --config ../../oxlint.config.ts --deny-warnings src",
		"format": "oxfmt --config ../../oxfmt.config.ts src"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "^4.4.0",
		"@hugeicons/react": "^1.1.10",
		"@vercel/analytics": "^2.0.1",
		"@wrksz/themes": "workspace:*",
		"fumadocs-core": "16.18.2",
		"fumadocs-mdx": "15.5.1",
		"fumadocs-ui": "16.18.2",
		"motion": "^14.10.1",
		"next": "16.4.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"takumi-js": "^2.19.0"
	},
	"devDependencies": {
		"@pierre/theme": "^2.0.0",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"postcss": "^8.5.32",
		"shiki": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2"
	}
}
