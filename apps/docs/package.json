{
	"name": "theme-docs",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "pnpm --filter @wrksz/themes build && next build",
		"dev": "next dev",
		"start": "next start",
		"test": "bun test src/__tests__",
		"types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
		"postinstall": "fumadocs-mdx",
		"lint": "oxlint --config ../../oxlint.config.ts --deny-warnings src",
		"format": "oxfmt --config ../../oxfmt.config.ts src"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "^4.0.0",
		"@hugeicons/react": "^1.1.6",
		"@takumi-rs/image-response": "^0.73.1",
		"@vercel/analytics": "^2.0.1",
		"@wrksz/themes": "workspace:*",
		"fumadocs-core": "16.11.5",
		"fumadocs-mdx": "15.2.0",
		"fumadocs-ui": "16.11.5",
		"motion": "^12.38.0",
		"next": "16.2.11",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.2.2",
		"@types/mdx": "^2.0.13",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3"
	}
}
